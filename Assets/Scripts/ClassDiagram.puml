@startuml
' Architecture overview: MonoBehaviour gameplay on top of a DOTS/ECS horde.
' Gameplay code never touches entities directly: it goes through the EnemyBridge facade.

skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultFontSize 13
hide members
hide circle
left to right direction

package "Gameplay (MonoBehaviour)" {
    class GameManager
    class WaveDirector
    class Player
    class WeaponManager
    class "Sword / FireWand" as Direct
    class "Aura / Nova / Bomb" as Area
    class "LevelUpManager / HUD" as UI
}

package "DOTS / ECS (Burst jobs)" {
    class EnemyBridge <<facade>>
    class EnemySpawnerSystem
    class EnemyHashSystem <<spatial grid>>
    class EnemyAreaDamageSystem
    class EnemyMovementSystem
    class EnemyDeathSystem
    class "Experience systems" as XP
}

GameManager --> WaveDirector : starts the run
Player --> WeaponManager
WeaponManager --> Direct
WeaponManager --> Area
Player --> UI : level up (observer)

Direct --> EnemyBridge : direct hits
Area --> EnemyBridge : queued area damage
EnemyBridge --> EnemyHashSystem : reads the grid
EnemyBridge --> EnemyAreaDamageSystem

WaveDirector --> EnemySpawnerSystem : spawn budgets
EnemyHashSystem --> EnemyMovementSystem : neighbours
EnemyDeathSystem --> Player : contact damage, victory
XP --> Player : experience

@enduml
